# ============================================================================
# Firefly — environment variable template
# Copy to .env.local (gitignored) and fill in real values.
# Convex-side variables (no VITE_ prefix) must ALSO be set in the Convex
# dashboard → Settings → Environment Variables, since Convex functions run
# on Convex infrastructure, not your local .env.
# ============================================================================

# --- Convex deployment (provisioned by `bunx convex dev`) ---
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# --- Groq (LLM primary + fallback, Whisper alignment) -----------------------
# Get key: https://console.groq.com/keys
# Set server-side in Convex dashboard.
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# --- OpenRouter (optional — swap text LLMs to free models) ------------------
# When OPENROUTER_API_KEY is set (and the provider is enabled in
# convex/lib/models.ts), the director / sub-agents / critic / memory / intro
# route through OpenRouter instead of Groq. Whisper, vision, moderation, and
# TTS stay on their own providers. Leave blank to keep everything on Groq.
# Get key: https://openrouter.ai/keys  ·  Set server-side in Convex dashboard.
OPENROUTER_API_KEY=
# Defaults if unset (baked into convex/lib/models.ts). Newest DeepSeek V4,
# all tool-capable. ~$0.02/question total — override to taste.
MODEL_PRIMARY=deepseek/deepseek-v4-pro
MODEL_FALLBACK=deepseek/deepseek-v4-flash
MODEL_UTILITY=deepseek/deepseek-v4-flash
# Max agentic muscle on the director instead: MODEL_PRIMARY=moonshotai/kimi-k2
# Newest Google (pricier — $1.50/$9): MODEL_PRIMARY=google/gemini-3.5-flash

# --- Sarvam (TTS) -----------------------------------------------------------
# Get key: https://dashboard.sarvam.ai
# Set server-side in Convex dashboard.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=en-IN

# --- OAuth (optional — enable Google sign-in) -------------------------------
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${CONVEX_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Transactional email (password reset + verification) -------------------
# Resend: https://resend.com/api-keys
AUTH_RESEND_KEY=

# --- Observability (optional) ----------------------------------------------
# Sentry: https://sentry.io  (VITE_ for browser, SENTRY_DSN for Convex)
VITE_SENTRY_DSN=
SENTRY_DSN=
# PostHog: https://posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- App --------------------------------------------------------------------
SITE_URL=http://localhost:3000
